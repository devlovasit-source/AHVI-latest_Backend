{
"version": "1.0",

"experience": "mood_board",

"description": "A visual inspiration experience that helps users explore, visualize, align, and decide on a desired aesthetic, lifestyle, event, destination, or personal transformation.",

"experience_objective": {

```
"primary_goal":
  "Help users visualize a desired outcome before making decisions.",

"secondary_goals": [

  "inspire_action",

  "clarify_preferences",

  "reduce_decision_uncertainty",

  "align_recommendations",

  "increase_confidence"
]
```

},

"activation_conditions": [

```
"inspiration_requested",

"style_exploration",

"event_planning",

"travel_planning",

"beauty_exploration",

"lifestyle_planning",

"goal_visualization",

"identity_exploration"
```

],

"mood_board_types": {

```
"fashion": {

  "purpose":
    "Explore personal style directions."
},

"beauty": {

  "purpose":
    "Explore beauty looks and aesthetics."
},

"travel": {

  "purpose":
    "Visualize destinations and experiences."
},

"event": {

  "purpose":
    "Visualize weddings, parties, celebrations and occasions."
},

"lifestyle": {

  "purpose":
    "Visualize habits, routines and lifestyle aspirations."
},

"home": {

  "purpose":
    "Visualize spaces, decor and organization."
},

"personal_growth": {

  "purpose":
    "Visualize future identity and goals."
}
```

},

"required_context": {

```
"critical": [

  "intent",

  "goal"
],

"important": [

  "preferences",

  "calendar",

  "style_profile",

  "life_domain"
]
```

},

"board_structure": {

```
"hero_card": {

  "required": true,

  "elements": [

    "theme",

    "objective",

    "mood_direction"
  ]
},

"visual_grid": {

  "required": true,

  "minimum_assets": 6,

  "maximum_assets": 20
},

"theme_analysis": {

  "required": true,

  "elements": [

    "colors",

    "textures",

    "aesthetic_keywords",

    "emotional_tone"
  ]
},

"inspiration_insights": {

  "required": true
},

"recommended_direction": {

  "required": true
},

"next_best_action": {

  "required": true
}
```

},

