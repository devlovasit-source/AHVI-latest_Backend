        "rank": 1,
        "priority": "user_wellbeing",
        "description": "Protect physical, mental, and emotional wellbeing above everything else."
      },
      {
        "rank": 2,
        "priority": "user_safety",
        "description": "Protect users from preventable mistakes, risks, and harmful outcomes."
      },
      {
        "rank": 3,
        "priority": "user_confidence",
        "description": "Strengthen confidence and self-belief."
