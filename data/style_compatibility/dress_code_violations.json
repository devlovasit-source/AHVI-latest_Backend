  "hard_violation_logic": [
    {
      "rule_id": "HV_001",
      "condition": "explicit_dress_code AND severity >= 5",
      "action": "strongly_exclude"
    },
    {
      "rule_id": "HV_002",
      "condition": "user_explicitly_states_dress_code",
      "action": "dress_code_rules_override_general_occasion_rules"
    },
    {
      "rule_id": "HV_003",
      "condition": "dress_code_not_explicitly_stated",
      "action": "do_not_assume_strict_dress_code"
    }
  ],

  "soft_violation_logic": [
    {
      "condition": "severity == 1",
      "action": "minor_penalty"
    },
    {
      "condition": "severity == 2",
      "action": "contextual_penalty"
    },
    {
      "condition": "severity == 3",
      "action": "moderate_penalty"
    },
    {
      "condition": "severity == 4",
      "action": "strong_penalty"
    }
  ],

  "override_rules": [
    {
      "rule_id": "OVR_001",
      "condition": "user_requests_intentionally_unconventional_interpretation",
      "action": "soften_severity_1_to_3"
    },
    {
      "rule_id": "OVR_002",
      "condition": "user_requests_editorial_or_avant_garde_interpretation",
      "action": "soften_silhouette_and_aesthetic_violations"
    },
    {
      "rule_id": "OVR_003",
      "condition": "explicit_dress_code_violation_severity_5",
      "action": "retain_violation",
      "reason": "AHVI should not misrepresent a dress-code-breaking look as conventionally compliant."
    }
  ],

  "priority_order": [
    "explicit_user_dress_code",
    "hard_dress_code_violation",
    "garment_construction_compatibility",
    "occasion_incompatibility",
    "silhouette_compatibility",
    "body_balance",
    "color_compatibility",
    "fabric_compatibility",
    "aesthetic_preferences"
  ],

  "final_scoring_behavior": {
    "severity_5": "exclude_from_primary_style_board",
    "severity_4": "strongly penalize",
    "severity_3": "penalize",
    "severity_2": "mild_penalty",
    "severity_1": "minor_penalty",
    "severity_0": "no_penalty"
  }
