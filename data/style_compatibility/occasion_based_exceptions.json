  "hard_override_rules": [
    {
      "rule_id": "HARD_001",
      "condition": "garment construction is fundamentally incompatible with silhouette",
      "action": "never_override",
      "examples": [
        "leggings + wide_leg",
        "wide_leg_trousers + bodycon",
        "mini_skirt + floor_length",
        "maxi_skirt + mini",
        "bodycon_dress + very_oversized"
      ]
    },

    {
      "rule_id": "HARD_002",
      "condition": "garment structure would be physically or functionally compromised",
      "action": "never_override",
      "examples": [
        "highly_structured_tailoring + extreme_deformation",
        "functional_outerwear + incompatible_construction"
      ]
    }
  ],

  "context_priority": [
    "hard_garment_compatibility",
    "occasion",
    "user_requested_aesthetic",
    "silhouette_balance",
    "color_harmony",
    "fabric_compatibility",
    "accessory_compatibility"
  ],

  "default_behavior": {
    "if_no_exception_matches": "retain_original_negative_penalty",
    "if_exception_matches": "apply_exception_override",
    "if_multiple_exceptions_match": "use_highest_strength_exception",
    "if_occasion_and_aesthetic_conflict": "occasion_takes_priority",
    "if_user_explicitly_requests_style": "allow_requested_aesthetic_to_reduce_soft_penalties",
    "never_reject_based_on_body_balance_alone": true
  }
}